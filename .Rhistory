# Load packages
library(ggplot2)
# Import Dice dissimilarity
dice <- read.csv2(
"results/tables/dice_distance.csv",
check.names = FALSE,
row.names = 1
)
# Convert to distance matrix
dist_dice <- as.dist(as.matrix(dice))
# Principal Coordinates Analysis
pcoa <- cmdscale(
dist_dice,
k = 2,
eig = TRUE,
add = TRUE
)
# Extract coordinates
pcoa_data <- data.frame(
isolate = rownames(pcoa$points),
PCoA1 = pcoa$points[, 1],
PCoA2 = pcoa$points[, 2]
)
# Explained variation from corrected eigenvalues
positive_eig <- pcoa$eig[pcoa$eig > 0]
variance <- 100 * positive_eig / sum(positive_eig)
# Plot
p <- ggplot(
pcoa_data,
aes(x = PCoA1, y = PCoA2)
) +
geom_point(size = 2.5) +
labs(
title = "BOX-PCR - Principal Coordinates Analysis",
x = paste0("PCoA1 (", round(variance[1], 1), "%)"),
y = paste0("PCoA2 (", round(variance[2], 1), "%)")
) +
theme_bw()
print(p)
source("~/BOX-PCR_R_Analysis/04_fingerprint_pcoa.R")
source("~/BOX-PCR_R_Analysis/04_fingerprint_pcoa.R")
pcoa_combined <- ggplot(
pcoa_data,
aes(
x = PCoA1,
y = PCoA2,
color = Accession,
shape = BAG
)
) +
geom_point(size = 3, alpha = 0.85) +
labs(
title = "BOX-PCR Fingerprint Diversity",
x = paste0("PCoA1 (", round(variance[1], 1), "%)"),
y = paste0("PCoA2 (", round(variance[2], 1), "%)")
) +
theme_bw()
print(pcoa_combined)
ggsave(
file.path(figures_path, "pcoa_accession_bag.png"),
pcoa_combined,
width = 8,
height = 6,
dpi = 300
)
