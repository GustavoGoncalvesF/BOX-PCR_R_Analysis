# Similarity thresholds
similarities <- seq(0.50, 1.00, by = 0.05)
# Count groups at each threshold
data.frame(
Similarity = similarities,
Groups = sapply(similarities, function(s) {
length(unique(cutree(hc, h = 1 - s)))
})
)
